			<!-- Remove when parent dependencies are upgraded to versions that include a safe transitive -->
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-core</artifactId>
				<version>2.18.11</version>
			</dependency>
			<!-- Pin jackson-databind to safe version: CVE-2020-36518, CVE-2022-42004, CVE-2022-42003, CVE-2021-46877, CVE-2026-54514, CVE-2026-54513, CVE-2026-54512, CVE-2026-91776, CVE-2026-91777 -->
