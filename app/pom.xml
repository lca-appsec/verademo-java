<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.veracode</groupId>
	<artifactId>verademo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>verademo</name>
	<url>https://github.com/veracode/verademo</url>
	<packaging>war</packaging>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.7.17</version>
		<relativePath/>
	</parent>

	<!-- Component Version Properties -->
	<properties>
		<spring.version>4.3.10.RELEASE</spring.version>
		<springboot.version>2.7.17</springboot.version>
		<fileupload.version>1.6.0</fileupload.version>
	</properties>
	<!-- Dependency Management to pin transitive dependencies -->
	<dependencyManagement>
		<dependencies>
			<!-- Pin log4j-api to safe version: CVE-2026-49844 -->
			<!-- Transitive dependency brought in by Spring Boot/logging dependencies -->
			<!-- Remove when parent dependencies are upgraded to versions that include a safe transitive -->
			<dependency>
				<groupId>org.apache.logging.log4j</groupId>
				<artifactId>log4j-api</artifactId>
				<version>2.25.5</version>
			</dependency>
			<!-- Pin commons-compress to safe version: CVE-2023-42503, CVE-2024-25710, CVE-2024-26308 -->
			<!-- Transitive dependency brought in by parent dependencies -->
			<!-- Remove when parent dependencies are upgraded to versions that include a safe transitive -->
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-compress</artifactId>
				<version>1.26.0</version>
			</dependency>
			<!-- Pin snappy to safe version: CVE-2024-36124 -->
			<!-- Transitive dependency -->
			<!-- Remove when parent dependencies are upgraded to versions that include a safe transitive -->
			<dependency>
				<groupId>org.iq80.snappy</groupId>
				<artifactId>snappy</artifactId>
				<version>0.5</version>
			</dependency>
			<!-- Pin log4j-core to safe version: CVE-2019-17571, CVE-2021-4104, CVE-2022-23307, CVE-2020-9493, CVE-2022-23302, CVE-2022-23305, CVE-2023-26464 -->
			<!-- Transitive dependency log4j:log4j migrated to org.apache.logging.log4j:log4j-core -->
			<!-- Brought in by slf4j-log4j12 -->
			<!-- Remove when slf4j-log4j12 is upgraded or replaced with a version that includes a safe transitive -->
